# Servidor
NODE_ENV=development
PORT=4000

# Banco PostgreSQL (ajuste usuário/senha/nome do banco)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sax"

# JWT - use em produção: openssl rand -base64 32
JWT_SECRET=altere-isso-em-producao-use-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# CORS - URLs do front PDV e do site (separadas por vírgula)
CORS_ORIGIN=http://localhost:3031,http://localhost:3000
