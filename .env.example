# ─── Variáveis da aplicação ──────────────────────────────
# Todas as variáveis que o código consome (src/).
# Em dev, defaults internos cobrem a maioria — basta DATABASE_URL.
# Em produção, preencher TODAS no Portainer.

# ─── Desenvolvimento local ───────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:123456@localhost:5432/sax

# JWT (defaults no código: secret inseguro, expiração 7d)
JWT_SECRET=dev-secret-troque-em-producao
JWT_EXPIRES_IN=7d

# CORS — origens separadas por vírgula
CORS_ORIGIN=http://localhost:3031,http://localhost:3000

# URL pública da API — usada em redirects de OAuth e webhooks (integrations.ts)
SAX_API_URL=http://localhost:4000

# URL do front — usada em redirects de OAuth (integrations.ts)
SAX_FRONT_URL=http://localhost:3031

# OAuth — deixar vazio desativa a integração
DROPBOX_CLIENT_ID=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

# Mapbox — token de acesso para geocodificação de endereços de imóveis
# Aceita também: MAPBOX_ACCESS_TOKEN ou NEXT_PUBLIC_MAPBOX_TOKEN
MAPBOX_TOKEN=pk.eyJ1IjoImEiOiJj...

# ─── Produção (preencher no Portainer / servidor) ────────
# NODE_ENV=production
# PORT=4000
# DATABASE_URL=postgresql://sax:<SENHA>@postgres:5432/sax
# JWT_SECRET=<gere com: openssl rand -base64 32>
# JWT_EXPIRES_IN=7d
# CORS_ORIGIN=<urls dos fronts separadas por vírgula>
# SAX_API_URL=https://api-sax.arvis.com.br
# SAX_FRONT_URL=<url do PDV na Vercel>
# DROPBOX_CLIENT_ID=<se usar>
# GOOGLE_CLIENT_ID=<se usar>
# MICROSOFT_CLIENT_ID=<se usar>
# MAPBOX_TOKEN=<token do Mapbox — mesma chave usada nos fronts>

# ─── DigitalOcean Spaces (object storage) ────────────────
# Prefixo separa os ambientes dentro do bucket "arvis":
#   sax-local → local  |  sax-dev → dev  |  sax → prod
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_KEY=<access-key>
DO_SPACES_SECRET=<secret-key>
DO_SPACES_BUCKET=arvis
DO_SPACES_PREFIX=sax-local
