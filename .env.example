# ─── Desenvolvimento LOCAL (mesma estrutura do env de produção, URLs em localhost) ─
# Copie para `.env` e preencha senhas/chaves. O arquivo `.env` não é versionado.

NODE_ENV=development
PORT=4000

# API rodando na máquina (npm): use localhost. Dentro do Docker Compose com serviço `postgres`: use host `postgres`.
# Senha com caracteres especiais no URI: codifique (ex.: ! → %21).
DATABASE_URL=postgresql://sax:<SENHA_POSTGRES>@localhost:5432/sax

JWT_SECRET=<openssl rand -base64 32>
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:3031,http://localhost:3000,http://127.0.0.1:3031,http://127.0.0.1:3000

SAX_API_URL=http://localhost:4000
SAX_FRONT_URL=http://localhost:3031

DROPBOX_CLIENT_ID=
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

MAPBOX_TOKEN=<token Mapbox>

# ─── DigitalOcean Spaces ─────────────────────────────────
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_KEY=<access-key>
DO_SPACES_SECRET=<secret-key>
DO_SPACES_BUCKET=arvis
DO_SPACES_PREFIX=sax-local

# ─── Opcional: docker-compose / pgAdmin / registry (não usado pelo Node em src/) ─
POSTGRES_PASSWORD=<senha do Postgres no compose>
PGADMIN_EMAIL=<email>
PGADMIN_PASSWORD=<senha pgAdmin>
DOCKERHUB_USERNAME=<user>
DOCKERHUB_TOKEN=<token>

# ─── Webhooks CRM (opcional — preferir credenciais por loja em Admin → Integrações) ─
# META_APP_SECRET=          # assinatura X-Hub-Signature-256 se não usar App Secret por loja
# META_LEADS_VERIFY_TOKEN= # fallback se não definir "Verify Token" na integração Meta
# META_PAGE_ACCESS_TOKEN=  # fallback para baixar dados do lead na Graph API
# META_GRAPH_VERSION=v21.0
# GOOGLE_LEADS_WEBHOOK_SECRET= # fallback se não definir segredo na integração Google

# ─── Produção (referência) ───────────────────────────────
# DATABASE_URL=...@postgres:5432/...
# CORS_ORIGIN=https://arvis.com.br,https://sax-arvis.vercel.app,...
# SAX_API_URL=https://api-sax.arvis.com.br
# SAX_FRONT_URL=https://sax-arvis.vercel.app
