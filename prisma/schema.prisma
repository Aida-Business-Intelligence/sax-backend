generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(cuid())
  name        String   // admin, caixa, gerente, etc.
  permissions String?  // JSON array de permissões
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String?
  phone       String?
  active      Boolean   @default(true)
  roleId      String
  role        Role      @relation(fields: [roleId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  helpDeskAssignedTickets HelpDeskTicket[] @relation("HelpDeskAssigned")
  helpDeskCreatedTickets  HelpDeskTicket[] @relation("HelpDeskCreatedBy")
  helpDeskMessages        HelpDeskMessage[] @relation("HelpDeskMsgUser")
  crmLeadsAssigned        CrmLead[]        @relation("CrmLeadAssignee")
  crmLeadInteractions     CrmLeadInteraction[] @relation("CrmLeadInteractionAuthor")
  hrEmployee              HrEmployee?
  siteStoriesCreated      SiteStory[] @relation("SiteStoryAuthor")
}

model Warehouse {
  id            String    @id @default(cuid())
  warehouseCode String    // código da loja (ex: 001)
  warehouseName String    // nome fantasia
  razaoSocial   String?   // razão social
  type          String?   // tipo (ex: matriz, filial)
  telefone      String?
  email         String?
  cidade        String?
  estado        String?
  cep           String?
  address       String?   // logradouro / endereço
  numero        String?
  complemento   String?
  bairro        String?
  cnpj          String?
  ie            String?   // inscrição estadual
  im            String?   // inscrição municipal
  cnae          String?
  ibgeUfId      String?   @map("ibge_uf_id")
  ibgeMunicipioId String? @map("ibge_municipio_id")
  note          String?   // observações
  display       Boolean   @default(true) // ativo/inativo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  users         User[]
  clients       Client[]
  proprietarios Proprietario[]
  properties    Property[]
  helpDeskTickets HelpDeskTicket[]
  crmLeads      CrmLead[]
  hrEmployees   HrEmployee[]
  siteStories   SiteStory[]
  finCategories   FinCategory[]
  finBankAccounts FinBankAccount[]
  finTransactions FinTransaction[]
  suppliers       Supplier[]
}

/// Fornecedor (serviços, produtos ou ambos) por loja.
model Supplier {
  id           String   @id @default(cuid())
  warehouseId  String   @map("warehouse_id")
  name         String
  /// pf | pj
  personType   String   @default("pj") @map("person_type")
  document     String?
  email        String?
  phone        String?
  /// service | product | both
  supplyKind   String   @default("service") @map("supply_kind")
  /// Ex.: limpeza, TI — quando supplyKind é service ou both
  serviceType  String?  @map("service_type")
  /// Ex.: material construção — quando supplyKind é product ou both
  productType  String?  @map("product_type")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@index([warehouseId])
  @@index([supplyKind])
  @@map("suppliers")
}

/// Colaborador (RH): ficha de pessoa física; opcionalmente vinculado a um User (credencial do sistema).
model HrEmployee {
  id                String    @id @default(cuid())
  warehouseId       String?   @map("warehouse_id")
  fullName          String    @map("full_name")
  email             String?
  phone             String?
  document          String?
  /// commission_only | fixed_plus_commission | fixed_only
  employmentType    String    @default("fixed_only") @map("employment_type")
  /// comercial | financeiro | administrativo | marketing | secretaria | rh | outros
  departmentCode    String    @default("comercial") @map("department_code")
  isPartnerBroker   Boolean   @default(false) @map("is_partner_broker")
  baseSalaryMonthly Decimal?  @map("base_salary_monthly") @db.Decimal(14, 2)
  commissionNotes   String?   @map("commission_notes")
  notes             String?
  status            String    @default("active")
  userId            String?   @unique @map("user_id")
  hiredAt           DateTime? @map("hired_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([warehouseId])
  @@index([departmentCode])
  @@index([status])
  @@index([employmentType])
  @@map("hr_employees")
}

// ----------------------------------------------------------------------
// Cadastros: clientes, proprietários, tags, seções do site
// ----------------------------------------------------------------------

model Client {
  id                    String    @id @default(cuid())
  name                  String
  email                 String?
  phone                 String?
  document              String?
  documentType          String?
  birthDate             DateTime?
  gender                String?
  warehouseId           String?
  zip                   String?
  address               String?   // rua / billing_street
  addressNumber         String?
  complement            String?
  neighborhood          String?
  city                  String?
  state                 String?
  note                  String?
  marketingConsent      Boolean?  @default(false)
  communicationPreference String?
  registrationIncomplete Boolean  @default(false) @map("registration_incomplete")
  /// Inativo após soft delete ou desativação manual; listagens usam só ativos não excluídos.
  active                Boolean   @default(true)
  /// Preenchido em soft delete (cliente com negócio CRM ligado a imóvel — não apaga linha).
  deletedAt             DateTime? @map("deleted_at")
  warehouse             Warehouse? @relation(fields: [warehouseId], references: [id])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  properties            Property[]
}

model Proprietario {
  id              String    @id @default(cuid())
  nome            String
  email           String?
  telefone        String?
  tipo_documento  String?
  cpf_cnpj        String?
  cep             String?
  endereco        String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  observacoes     String?
  warehouse_id    String
  status          String    @default("pending")
  origem          String    @default("erp")
  subdomain       String?   @unique
  access_email    String?
  password_hash   String?
  // Última senha provisória definida pelo PDV (exibir na edição; login usa password_hash).
  lastProvisionalPassword String? @map("last_provisional_password")
  credentialNotifyEmail        String? @map("credential_notify_email")
  credentialNotifyWhatsapp     String? @map("credential_notify_whatsapp")
  credentialPortalBaseUrl      String? @map("credential_portal_base_url")
  must_change_password Boolean @default(false)
  approvedAt      DateTime?
  rejectedAt      DateTime?
  /// JSON: preferências de privacidade do portal (ex.: { marketingEmail: true })
  privacyJson     String?   @map("privacy_json")
  /// URL relativa da foto de perfil (ex.: /uploads/proprietarios/avatars/...)
  fotoUrl         String?   @map("foto_url")
  warehouse       Warehouse @relation(fields: [warehouse_id], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  helpDeskTickets HelpDeskTicket[]
}

model Tag {
  id        String       @id @default(cuid())
  name      String       // ex: Frente Mar, Luxo, Lançamento
  slug      String       @unique
  active    Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  properties PropertyTag[]
}

// Seção do site (ex: bloco "Frente Mar" na home). Imóveis são vinculados no cadastro do imóvel (campo "Exibir nas seções").
model Section {
  id        String   @id @default(cuid())
  title     String   // título exibido no site (ex: Frente Mar)
  slug      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  properties PropertySection[]
}

model Property {
  id           String   @id @default(cuid())
  ref          String?  // Referência automática ex: REF-00001 (gerada no create)
  slug         String   @unique
  title        String
  description  String?
  type         String   // venda, aluguel (primeiro tipo)
  transactionTypes String? // JSON array ["venda","aluguel","crowdfunding"]
  status       String   @default("draft") // draft, published, archived
  propertyType String?  // casa, apartamento, terreno, etc.
  price        Decimal? @db.Decimal(14, 2)  // legado / primeiro tipo
  priceVenda   Decimal? @db.Decimal(14, 2)
  priceAluguel Decimal? @db.Decimal(14, 2)
  priceCrowdfunding Decimal? @db.Decimal(14, 2)
  area         Decimal? @db.Decimal(10, 2)
  bedrooms     Int?
  suites       Int?   // quantos quartos são suítes
  demiSuites   Int?   // quantos são demi-suítes
  bathrooms    Int?
  garage       Int?
  address      String?
  numero       String?  // número do imóvel (logradouro + número no mapa)
  city         String?
  neighborhood String?
  state        String?
  zip          String?
  builder      String?  // Construtora
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  // Hash do endereço na última geocodificação (logradouro+número+bairro+cidade+UF+CEP)
  geoAddressKey String?
  warehouseId  String
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id])
  proprietarioId String?  // ID do módulo Proprietários
  /// null = cadastro master; pending = aguardando aprovação; approved/rejected = fluxo portal proprietário
  ownerSubmissionStatus String? @map("owner_submission_status")
  comodidades  String?   // JSON array ["piscina","elevador",...]
  mobiliado    Boolean?  @default(false)
  aceita_pets  Boolean?  @default(false)
  aceita_permuta Boolean? @default(false)
  em_construcao Boolean? @default(false)
  parceria     Boolean?  @default(false)
  dataPrevistaEntrega DateTime?
  tagImovel    String?   // JSON array de tags
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  media        PropertyMedia[]
  tags         PropertyTag[]
  sections     PropertySection[]
  crmLeadDeals CrmLeadDeal[]

  @@unique([warehouseId, ref], map: "Property_warehouseId_ref_key")
}

model PropertyTag {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([propertyId, tagId])
}

// Imóvel exibido em quais seções do site (escolhido no cadastro do imóvel).
model PropertySection {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sectionId  String
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  @@id([propertyId, sectionId])
}

model PropertyMedia {
  id         String   @id @default(cuid())
  url        String
  type       String   // image, video
  sortOrder  Int      @default(0)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// Configuração do site público (banners, logo, favicon, menu, hero, logos parceiros). Uma única linha (singleton).
model SiteConfig {
  id                  String   @id @default(cuid())
  featuredPropertyIds String?  // JSON array ["id1","id2",...] - imóveis no banner/carrossel
  logoUrl             String?
  faviconUrl          String?  // ícone da aba do navegador (favicon)
  menuItems           String?  // JSON array de itens do menu (label, path, etc.)
  heroContent         String?  // JSON: título, subtítulo, botão, exibição do mapa, etc.
  partnerLogos        String?  // JSON array [{ url, name? }] - logos da seção Nossos Parceiros
  aboutContent        String?  // JSON: textos e links da página Sobre nós
  footerContent       String?  // JSON: rodapé (creci, copyright, redes sociais)
  transactionTypes    String?  // JSON array [{ value, label }] - tipos no cadastro (Venda, Aluguel, Crowdfunding, etc.)
  exclusiveProjectsContent String? // JSON: textos e imagens da página /projetos-exclusivos
  imoveisContent      String?  // JSON: CTA WhatsApp na página de detalhe do imóvel, etc.
  proprietariosContent String? // JSON: textos da página /para-proprietarios (sax-site)
  /// Funil "Modo Caça" no sax-site (overlay gamificado de captura).
  huntModeEnabled     Boolean  @default(false)
  /// Conta Instagram Business (Graph API) — ID numérico da conta conectada ao Facebook Page.
  instagramBusinessAccountId String? @map("instagram_business_account_id")
  /// Token de longa duração (armazenar com cuidado em produção).
  instagramAccessToken       String? @map("instagram_access_token") @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Stories estilo Instagram publicadas no PDV e exibidas no sax-site (/feed).
model SiteStory {
  id                String    @id @default(cuid())
  warehouseId       String?   @map("warehouse_id")
  imageUrl          String    @map("image_url")
  caption           String?
  /// Texto curto abaixo da bolha no /feed (ex.: construtora, bairro), estilo “nome” do Instagram.
  bubbleLabel       String?   @map("bubble_label") @db.VarChar(80)
  /// JSON: { textLayers?: [...], linkLayers?: [...] } — posições em % do container (0–100).
  overlays          Json?
  sortOrder         Int       @default(0) @map("sort_order")
  published         Boolean   @default(true)
  publishedAt       DateTime  @default(now()) @map("published_at")
  expiresAt         DateTime? @map("expires_at")
  createdByUserId   String?   @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy User?      @relation("SiteStoryAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([published, sortOrder])
  @@index([warehouseId])
  @@map("site_stories")
}

// Blog do site: cadastrado no PDV (admin), exibido no sax-site no menu Blog.
model BlogPost {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String
  content    String
  coverUrl   String?
  tags       String?  // JSON array ["tag1","tag2"]
  authorName String   @default("Equipe SAX")
  published  Boolean  @default(true)
  reactions  String?  // JSON { "likes": number }
  comments   String?  // JSON array [{ id, authorName, message, createdAt }]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Visitante do site: uma sessão com dados técnicos e de marketing (CRM).
model SiteVisitor {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())
  ip          String?
  userAgent   String?
  deviceType  String?   // mobile, desktop, tablet
  browser     String?
  os          String?
  country     String?
  city        String?
  region      String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([lastSeen])
  @@index([city])
}

// Leads/contatos captados no site (formulários com CPF, celular, etc.) para CRM e remarketing.
model SiteLead {
  id        String   @id @default(cuid())
  sessionId String?  // vincula ao SiteVisitor
  name      String?
  email     String?
  phone     String?
  cpf       String?
  source    String   @default("form") // form, contact, etc.
  consent   Boolean  @default(true)
  metadata  String?  // JSON: cidade, tipo, faixa de valor, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([email])
  @@index([phone])
}

/// Lead comercial unificado (PDV /leads): site, Modo Caça, Meta Ads (futuro), manual.
model CrmLead {
  id                      String    @id @default(cuid())
  warehouseId             String?   @map("warehouse_id")
  trackingVisitorId       String?   @unique @map("tracking_visitor_id")
  name                    String?
  email                   String?
  phone                   String?
  cpf                     String?
  pipelineStage           String    @default("novo") @map("pipeline_stage")
  source                  String    @default("manual")
  sourceDetail            String?   @map("source_detail")
  adTitle                 String?   @map("ad_title")
  adImageUrl              String?   @map("ad_image_url")
  adLocation              String?   @map("ad_location")
  interestPropertyType    String?   @map("interest_property_type")
  interestTransactionType String?   @map("interest_transaction_type")
  notes                   String?
  score                   Int       @default(0)
  lastInteractionAt       DateTime? @map("last_interaction_at")
  assignedUserId          String?   @map("assigned_user_id")
  metaLeadId              String?   @map("meta_lead_id")
  metaFormId              String?   @map("meta_form_id")
  /// Equipe deve executar próxima ação (ex.: ligar, visita) — destaca no CRM e na agenda.
  nextActionRequired      Boolean   @default(false) @map("next_action_required")
  nextActionNote          String?   @map("next_action_note")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  warehouse    Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  assignedUser User?      @relation("CrmLeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  deals        CrmLeadDeal[]
  interactions CrmLeadInteraction[]
  tasks        CrmLeadTask[]

  @@index([warehouseId])
  @@index([pipelineStage])
  @@index([source])
  @@index([phone])
  @@index([createdAt])
  @@map("crm_leads")
}

model CrmLeadDeal {
  id                String    @id @default(cuid())
  crmLeadId         String    @map("crm_lead_id")
  title             String
  value             Decimal?  @db.Decimal(14, 2)
  currency          String    @default("BRL")
  stage             String    @default("prospeccao")
  expectedCloseAt   DateTime? @map("expected_close_at")
  description       String?
  internalNotes     String?   @map("internal_notes")
  probability       Int?
  transactionType   String?   @map("transaction_type")
  propertyRef       String?   @map("property_ref")
  propertyId        String?   @map("property_id")
  responsible       String?
  commissionPct     Decimal?  @map("commission_pct") @db.Decimal(5, 2)
  paymentMethod     String?   @map("payment_method")
  /// Kanban pós-ganho: contrato, financeiro e documentos (JSON — colunas e cards).
  pipelineKanbanState Json?   @map("pipeline_kanban_state")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  crmLead      CrmLead             @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  property     Property?           @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  interactions CrmLeadInteraction[]

  @@index([crmLeadId])
  @@index([propertyId])
  @@map("crm_lead_deals")
}

model CrmLeadInteraction {
  id              String   @id @default(cuid())
  crmLeadId       String   @map("crm_lead_id")
  crmLeadDealId   String?  @map("crm_lead_deal_id")
  /// Kanban: registrada | em_andamento | aguardando_retorno | concluida
  status          String   @default("registrada") @map("status")
  type            String   @default("nota")
  title           String
  description     String?
  authorName      String?  @map("author_name")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  crmLead     CrmLead      @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)
  crmLeadDeal CrmLeadDeal? @relation(fields: [crmLeadDealId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("CrmLeadInteractionAuthor", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([crmLeadId])
  @@index([crmLeadDealId])
  @@index([status])
  @@index([createdAt])
  @@map("crm_lead_interactions")
}

model CrmLeadTask {
  id              String   @id @default(cuid())
  crmLeadId       String   @map("crm_lead_id")
  title           String
  kind            String   @default("reuniao")
  scheduledAt     DateTime @map("scheduled_at")
  done            Boolean  @default(false)
  description     String?
  local           String?
  reminderMinutes Int?     @map("reminder_minutes")
  negocioRef      String?  @map("negocio_ref")
  checkedInAt     DateTime? @map("checked_in_at")
  reminderSentAt  DateTime? @map("reminder_sent_at")
  whatsappConfirmationSentAt DateTime? @map("whatsapp_confirmation_sent_at")
  /// baixa | normal | alta | urgente (low, normal, high, urgent)
  priority        String   @default("normal") @map("priority")
  participantUserIds Json? @map("participant_user_ids")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  crmLead CrmLead @relation(fields: [crmLeadId], references: [id], onDelete: Cascade)

  @@index([crmLeadId])
  @@index([scheduledAt])
  @@map("crm_lead_tasks")
}

// Eventos de analytics (navegação, tempo em página, cliques, scroll, buscas).
model SiteAnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  eventType String   // page_view, property_view, search, time_on_page, scroll, click
  path      String?
  payload   String?  // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}

// ----------------------------------------------------------------------
// Tracking CRM: visitante identificado por fingerprint (persistente, logado ou não)
// ----------------------------------------------------------------------

model Visitor {
  id               String   @id @default(cuid())
  /// ID estável no cliente (cookie + localStorage) para rastrear o funil mesmo se o fingerprint de sessão mudar.
  clientVisitorId  String?  @unique @map("client_visitor_id")
  fingerprint      String   @unique
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions TrackingSession[]
  events   TrackingEvent[]
  lead     Lead?

  @@index([fingerprint])
  @@index([clientVisitorId])
  @@index([updatedAt])
}

model Lead {
  id             String    @id @default(cuid())
  visitorId      String    @unique
  name           String?
  email          String?
  phone          String?
  status         String    @default("new")
  score          Int       @default(0) // intenção de compra
  temperature    String    @default("cold") // cold, warm, hot (score > 20 → warm, > 50 → hot)
  lastActivityAt DateTime? // última atividade do visitante (atualizado a cada evento)
  createdAt      DateTime  @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([status])
  @@index([score])
  @@index([temperature])
}

model TrackingSession {
  id        String    @id @default(cuid())
  visitorId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  visitorId String
  type      String   // PAGE_VIEW, VIEW_PROPERTY, CLICK_WHATSAPP, SEARCH, etc.
  data      Json     // payload flexível
  createdAt DateTime @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([type])
  @@index([createdAt])
}

// ----------------------------------------------------------------------
// Reimpacto: automações e fila de eventos (WhatsApp, follow-up)
// ----------------------------------------------------------------------

model Automation {
  id           String   @id @default(cuid())
  name         String   // ex: "Visitou imóvel 2x → mensagem"
  triggerType  String   // VIEW_PROPERTY_2X, CLICK_WHATSAPP
  triggerConfig Json?   // { minViews?, withinHours?, ... }
  actionType   String   // SEND_WHATSAPP, FOLLOW_UP
  actionConfig Json?    // { template?, message?, ... }
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  queueItems AutomationQueue[]

  @@index([active])
}

model AutomationQueue {
  id            String    @id @default(cuid())
  automationId  String
  visitorId     String
  leadId        String?   // opcional, para contexto
  payload       Json      // contexto: slug, type, etc.
  status        String    @default("pending") // pending, sent, failed
  scheduledFor  DateTime  @default(now())
  processedAt   DateTime?
  resultPayload Json?     // resposta WhatsApp ou erro
  createdAt     DateTime  @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([visitorId])
  @@index([status])
  @@index([scheduledFor])
}

// ----------------------------------------------------------------------
// Módulo File (PDV): pastas e arquivos por loja
// ----------------------------------------------------------------------

model FileFolder {
  id          String      @id @default(cuid())
  name        String
  filesCount  Int         @default(0)  // contagem de arquivos na pasta
  size        Int         @default(0)  // tamanho total em bytes
  isFavorite  Boolean     @default(false)
  warehouseId String?
  parentId    String?     // subpasta: pasta pai
  createdAt   DateTime    @default(now())
  updatedAt   DateTime   @updatedAt

  parent   FileFolder?  @relation("Subfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children FileFolder[] @relation("Subfolders")
  files    File[]
}

model File {
  id         String    @id @default(cuid())
  folderId   String
  name       String    // nome original do arquivo
  size       Int       @default(0) // bytes
  type       String?   // mime ou extensão
  path       String    // caminho relativo no disco (ex: uploads/files/xxx.pdf)
  isFavorite Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  folder FileFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

// Integrações de armazenamento (Dropbox, Drive, OneDrive) por usuário
model CloudIntegration {
  id           String    @id @default(cuid())
  userId       String
  provider     String
  accessToken  String?
  refreshToken String?
  email        String?
  integratedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// ----------------------------------------------------------------------
// Help Desk / SAC (proprietário ↔ equipe master)
// ----------------------------------------------------------------------

model HelpDeskTicket {
  id              String   @id @default(cuid())
  number          Int      @unique
  protocol        String   @unique // protocolo único (ex.: SAX-…), gerado na criação
  title           String
  status          String   @default("OPEN") // OPEN | PENDING | IN_PROGRESS | RESOLVED | CLOSED
  priority        String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  queue           String   @default("geral")
  proprietarioId  String
  proprietario    Proprietario @relation(fields: [proprietarioId], references: [id], onDelete: Cascade)
  warehouseId     String?
  warehouse       Warehouse? @relation(fields: [warehouseId], references: [id])
  assignedUserId  String?
  assignedUser    User?    @relation("HelpDeskAssigned", fields: [assignedUserId], references: [id])
  createdByStaff  Boolean  @default(false)
  createdByUserId String?
  createdByUser   User?    @relation("HelpDeskCreatedBy", fields: [createdByUserId], references: [id])
  firstMessageAt  DateTime?
  lastMessageAt   DateTime?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  messages        HelpDeskMessage[]
  events          HelpDeskTicketEvent[]

  @@index([status])
  @@index([proprietarioId])
  @@index([assignedUserId])
  @@index([queue])
  @@index([createdAt])
}

model HelpDeskMessage {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body          String
  imageUrl      String? // /uploads/helpdesk/{ticketId}/… (opcional; proprietário pode anexar imagem)
  authorType    String // owner | staff | system
  authorUserId  String?
  authorUser    User?    @relation("HelpDeskMsgUser", fields: [authorUserId], references: [id])
  readByOwnerAt DateTime?
  readByStaffAt DateTime?
  createdAt     DateTime @default(now())

  @@index([ticketId])
}

model HelpDeskTicketEvent {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      HelpDeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type        String // created | status_change | priority_change | assign | queue_change | message | closed
  payload     String? // JSON
  actorUserId String?
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

// ----------------------------------------------------------------------
// Financeiro PDV (painel: contas a pagar / receber)
// ----------------------------------------------------------------------

model FinCategory {
  id          String   @id @default(cuid())
  warehouseId String   @map("warehouse_id")
  /// receivable | payable
  kind        String
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  transactions FinTransaction[]

  @@index([warehouseId, kind])
  @@map("fin_categories")
}

model FinBankAccount {
  id            String   @id @default(cuid())
  warehouseId   String   @map("warehouse_id")
  name          String
  bankName      String?  @map("bank_name")
  agency        String?
  accountNumber String   @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  transactions FinTransaction[]

  @@index([warehouseId])
  @@map("fin_bank_accounts")
}

model FinTransaction {
  id            String   @id @default(cuid())
  warehouseId   String   @map("warehouse_id")
  /// RECEIVABLE | PAYABLE
  kind          String
  categoryId    String?  @map("category_id")
  company       String
  amount        Decimal  @db.Decimal(14, 2)
  currency      String   @default("BRL")
  date          DateTime @map("date")
  dueDate       DateTime @map("due_date")
  /// pending | paid | cancelled
  status        String   @default("pending")
  paidAt        DateTime? @map("paid_at")
  note          String?
  reference     String?  @map("reference")
  bankAccountId String?  @map("bank_account_id")
  /// Campos extras (parcelas fiscais, clientid, anexos, etc.)
  metadata      Json?    @map("metadata")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  category    FinCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bankAccount FinBankAccount?  @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  @@index([warehouseId, kind])
  @@index([dueDate])
  @@index([status])
  @@map("fin_transactions")
}

// ----------------------------------------------------------------------
// Módulo Mail: contas de e-mail conectadas por usuário (IMAP)
// ----------------------------------------------------------------------

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  email        String
  displayName  String?  // nome exibido (ex: "Trabalho", "Pessoal")
  provider     String   @default("imap") // imap | gmail | outlook
  imapHost     String
  imapPort     Int      @default(993)
  imapSecure   Boolean  @default(true)
  smtpHost     String?
  smtpPort     Int?
  credentials  String   // senha ou token encriptado
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}
